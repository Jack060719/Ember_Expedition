{
  "name": "ember-expedition",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node scripts/check-game.mjs",
    "test:arena": "node scripts/check-arena.mjs && node scripts/check-balance.mjs",
    "test:offline": "node scripts/check-offline.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
